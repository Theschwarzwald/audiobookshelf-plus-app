<?xml version="1.0" encoding="utf-8"?>
<resources>

  <!-- Base application theme. -->
  <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
    <!-- Customize your theme here. -->
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    <item name="colorAccent">@color/colorAccent</item>
  </style>

  <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
      <!-- ABS+: system dialogs (exit the app, confirmations) get their own theme: the dark android:background below
           would otherwise paint them black under dark text -->
      <item name="alertDialogTheme">@style/AbsAlertDialog</item>
      <item name="android:alertDialogTheme">@style/AbsAlertDialog</item>
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="android:background">@color/background_dark</item>
    <item name="android:statusBarColor">@color/background_dark</item>
    <item name="android:navigationBarColor">@color/background_dark</item>
  </style>


  <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
    <!--        <item name="android:background">@drawable/screen</item>-->
  </style>

  <style name="MediaPlayerWidgetTheme" parent="Theme.AppCompat.DayNight">
    <!-- These colors match the vue pages -->
    <item name="android:colorBackground">#232323</item>
    <item name="android:colorAccent">#373838</item>
    <item name="android:textColor">#ffffff</item>
  </style>

  <style name="Widget.Android.AppWidget.Container" parent="android:Widget">
    <item name="android:id">@android:id/background</item>
    <item name="android:background">?android:attr/colorBackground</item>
  </style>

  <style name="Widget.Android.AppWidget.InnerView" parent="android:Widget">
<!--    <item name="android:background">?android:attr/colorBackground</item>-->
<!--    <item name="android:textColor">?android:attr/textColorPrimary</item>-->
    <item name="android:padding">0dp</item>
  </style>

  <!-- ABS+: readable dialogs, light or dark with the system setting (light on e-ink) -->
  <style name="AbsAlertDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
    <item name="android:background">@null</item>
  </style>
</resources>
